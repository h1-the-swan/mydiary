# Backend credentials. Copy to backend/.env (gitignored) and fill in.
#
# docker-compose.yaml overrides a few of these with container paths --
# the three token-cache paths and JOPLIN_BASE_URL / OWNTRACKS_RECORDER_URL --
# so the values here are what a backend running outside Docker uses.
#
# A git worktree does not need its own copy: scripts/bootstrap-worktree.sh
# symlinks this file from the primary checkout, so credentials don't multiply.

# --- Spotify ---
# Register an app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=
SPOTIFY_TOKEN_CACHE_PATH=

# --- Joplin ---
# Token from Joplin desktop: Tools -> Options -> Web Clipper.
# Leave the port off JOPLIN_BASE_URL and the backend scans 41184-41194 to find
# the data API wherever it landed; give it a port to pin it and skip the scan.
JOPLIN_AUTH_TOKEN=
JOPLIN_BASE_URL=http://localhost
JOPLIN_NOTEBOOK_ID=

# --- Google Calendar ---
# Credentials file downloaded from the Google Cloud console; the token file is
# written on first authorization.
GOOGLECALENDAR_CREDENTIALS_FILE=
GOOGLECALENDAR_TOKEN_CACHE=

# --- Nextcloud ---
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=

# --- OwnTracks recorder ---
OWNTRACKS_RECORDER_URL=http://localhost:8083
OWNTRACKS_USER=

# --- API token for programmatic clients ---
# The X-API-Key checked by the /images/iphone_captures route. The check fails
# closed, so leaving this unset denies that route rather than opening it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MYDIARY_API_TOKEN=

# --- CARTO basemap key (optional) ---
# Without it the rendered maps still draw, watermarked "API KEY REQUIRED".
# Free, no account needed: https://carto.com/basemaps/apikey/
# The browser map needs the same value in mydiary-vuetify/.env, prefixed VITE_.
CARTO_BASEMAP_KEY=

# --- Habitica (optional) ---
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# --- Raindrop.io (optional) ---
RAINDROPIO_CLIENT_ID=
RAINDROPIO_TEST_TOKEN=

# --- Genius (optional, PerformSongs lyrics) ---
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=
GENIUS_ACCESS_TOKEN=

# --- Pocket (deprecated) ---
# Pocket shut down on 2025-07-08. Existing articles stay readable from the
# database; nothing fetches new ones, so these are no longer needed.
POCKET_CONSUMER_KEY=
POCKET_ACCESS_TOKEN=
